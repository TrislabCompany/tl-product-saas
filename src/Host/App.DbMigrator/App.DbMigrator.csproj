<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>App.DbMigrator</RootNamespace>
    <AssemblyName>App.DbMigrator</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- This is an internal operator-facing CLI — no localization, all
         operator messages are literal strings. CA1303 (use resource tables
         for user-facing strings) is the wrong rule for this project. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Trislab.Framework.Web" />
    <PackageReference Include="Trislab.Framework.Tenancy" />
    <PackageReference Include="Trislab.Modules.Auditing" />
    <PackageReference Include="Trislab.Modules.Auditing.Contracts" />
    <PackageReference Include="Trislab.Modules.Billing" /> <!-- [module:Billing] -->
    <PackageReference Include="Trislab.Modules.Billing.Contracts" /> <!-- [module:Billing] -->
    <ProjectReference Include="..\..\Samples\Catalog\Modules.Catalog\Modules.Catalog.csproj" /> <!-- [module:Catalog] -->
    <ProjectReference Include="..\..\Samples\Catalog\Modules.Catalog.Contracts\Modules.Catalog.Contracts.csproj" /> <!-- [module:Catalog] -->
    <ProjectReference Include="..\..\Samples\Chat\Modules.Chat\Modules.Chat.csproj" /> <!-- [module:Chat] -->
    <ProjectReference Include="..\..\Samples\Chat\Modules.Chat.Contracts\Modules.Chat.Contracts.csproj" /> <!-- [module:Chat] -->
    <PackageReference Include="Trislab.Modules.Files" /> <!-- [module:Files] -->
    <PackageReference Include="Trislab.Modules.Files.Contracts" /> <!-- [module:Files] -->
    <PackageReference Include="Trislab.Modules.Identity" />
    <PackageReference Include="Trislab.Modules.Multitenancy" />
    <ProjectReference Include="..\..\Samples\Tickets\Modules.Tickets\Modules.Tickets.csproj" /> <!-- [module:Tickets] -->
    <ProjectReference Include="..\..\Samples\Tickets\Modules.Tickets.Contracts\Modules.Tickets.Contracts.csproj" /> <!-- [module:Tickets] -->
    <PackageReference Include="Trislab.Modules.Webhooks" /> <!-- [module:Webhooks] -->
    <PackageReference Include="Trislab.Modules.Notifications" /> <!-- [module:Notifications] -->
  </ItemGroup>

  <!-- Share configuration with the API so connection strings + tenant options
       stay in lock-step. Production deployments override via env vars. -->
  <ItemGroup>
    <Compile Include="..\App.Api\Platform\PlatformConfiguration.cs" Link="Platform\PlatformConfiguration.cs" />
    <None Include="..\App.Api\appsettings.json"
          Link="appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\App.Api\appsettings.Development.json"
          Link="appsettings.Development.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
