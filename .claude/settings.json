{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Edit(/src/BuildingBlocks/**)",
      "Write(/src/BuildingBlocks/**)",
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ]
  }
}
